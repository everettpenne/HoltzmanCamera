<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera.any"/>

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!--
      androidx.media3:media3-common declares this for ExoPlayer's network playback. We only pull
      media3 in transitively through camera-video, which uses media3-muxer to write MP4s locally,
      so nothing we ship reads it and the app has no INTERNET permission to pair it with.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove"/>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="*" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:resizeableActivity="false"
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:category="image"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        android:enableOnBackInvokedCallback="true"
        android:memtagMode="async"
        tools:ignore="UnusedAttribute">

        <!-- The main activity of the app (supports all modes) -->
        <activity
            android:name=".ui.activities.MainActivity"
            android:taskAffinity=".ui.activities.MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:windowSoftInputMode="stateAlwaysHidden|adjustPan"
            android:screenOrientation="nosensor"
            android:exported="true"
            android:theme="@style/Theme.Camera"
            tools:ignore="DiscouragedApi">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <!--
          Holtzman Camera is a user-installed app. Android 11+ reserves the system camera
          intents (IMAGE_CAPTURE, VIDEO_CAPTURE, STILL_IMAGE_CAMERA and their secure variants)
          for preinstalled camera apps, so the user build does not declare them. A future
          system-image flavor can restore the upstream activities.
        -->

        <activity
            android:name=".ui.activities.VideoPlayer"
            android:theme="@style/Theme.Viewer"
            android:taskAffinity=".ui.activities.VideoPlayer"
            android:excludeFromRecents="true"
            android:exported="false"/>

        <activity
            android:name=".ui.activities.InAppGallery"
            android:theme="@style/Theme.Viewer"
            android:taskAffinity=".ui.activities.InAppGallery"
            android:excludeFromRecents="true"
            android:exported="false"/>

        <activity
            android:name=".ui.activities.MoreSettings"
            android:theme="@style/Theme.App"
            android:taskAffinity=".ui.activities.InAppGallery"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:exported="false"/>

    </application>

</manifest>
